# ==============================================================================
# NexusAuth Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env`: `cp .env.example .env`
# 2. Generate a secure 256-bit random key using Python:
#    python -c "import secrets; print(secrets.token_hex(32))"
# 3. Paste the output below as your SECRET_KEY.
# 4. NEVER commit the actual `.env` file to version control.
# ==============================================================================

# Cryptographic Secret Key for HMAC-SHA256 JWT signature generation and verification.
SECRET_KEY=replace_this_with_your_own_64_char_random_hex_key_for_production

# JWT Algorithm (Defaults to HS256: HMAC with SHA-256)
ALGORITHM=HS256

# JWT Expiration Lifetime in Minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server Host and Port Settings
HOST=127.0.0.1
PORT=8000
